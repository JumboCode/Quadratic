# Secrets for Edge Functions. Locally: copy to supabase/functions/.env.
# In production: `supabase secrets set --env-file supabase/functions/.env`
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.)

# Where the web app lives (used for links in GitHub issues and Slack messages)
APP_URL=https://jumbocode.github.io/Quadratic/

# Random string shared with the database (Vault secret `internal_secret`); guards cron/dispatch
INTERNAL_SECRET=change-me-to-a-long-random-string

# GitHub App (github.com/organizations/JumboCode/settings/apps)
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=quadratic-jumbocode
GITHUB_WEBHOOK_SECRET=another-random-string
# PKCS#8 PEM, newlines escaped as \n (see docs/SETUP.md)
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Slack app (api.slack.com/apps)
SLACK_CLIENT_ID=1234.5678
SLACK_CLIENT_SECRET=abc123
